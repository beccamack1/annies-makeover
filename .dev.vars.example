# Copy this file to .dev.vars to try the /admin page and the lock
# on this computer with "npm run cf:dev". Online, the password is
# a Cloudflare secret instead (see README).
ADMIN_PASSWORD=choose-a-long-password

# The 10-minute viewing-link lock (see README). "off" switches it off.
# Keep it off on this computer so you can always see the site here.
PREVIEW_LOCK=off
