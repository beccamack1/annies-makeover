# Copy this file to .env to try the /admin page on this computer
# with "npx netlify dev". On Netlify, set ADMIN_PASSWORD under
# Project configuration → Environment variables instead.
ADMIN_PASSWORD=choose-a-long-password

# The 10-minute viewing-link lock (see README). "off" switches it off.
# Keep it off on this computer so you can always see the site here.
PREVIEW_LOCK=off
